# =================================================================
# KrishiDrishti — Environment Configuration Template
# =================================================================
# Copy this file to .env.local and populate your credentials.
# NEVER commit .env.local or raw API keys to source control.

# -----------------------------------------------------------------
# 1. Computer Vision Leaf Pathology Model (HuggingFace)
# -----------------------------------------------------------------
HF_TOKEN=your_huggingface_user_access_token_here
NEXT_PUBLIC_HF_TOKEN=your_huggingface_user_access_token_here

# -----------------------------------------------------------------
# 2. AI Agriculture Chatbot Providers (OpenAI, Gemini, Groq)
# -----------------------------------------------------------------
# Groq API Configuration (Fast, reliable inference)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Configuration
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API Configuration
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------
# 3. AI Orchestration Strategy
# -----------------------------------------------------------------
# AI_PRIMARY_PROVIDER: 'auto' | 'groq' | 'gemini' | 'openai'
# In 'auto' mode, the system selects the best configured provider and
# automatically falls back to secondary providers if rate-limited or exhausted.
AI_PRIMARY_PROVIDER=auto

# AI_PROVIDER_STRATEGY: 'auto' | 'groq' | 'gemini' | 'openai'
AI_PROVIDER_STRATEGY=auto

# AI_FALLBACK_ENABLED: 'true' | 'false' (Enables graceful fallback upon failure)
AI_FALLBACK_ENABLED=true

# Default Language Mode: 'auto' | 'bn' | 'en' | 'banglish'
AI_LANGUAGE_DEFAULT=auto

# -----------------------------------------------------------------
# 4. Cloud Image Storage (Cloudinary / AWS S3)
# -----------------------------------------------------------------
# If Cloudinary or S3 keys are left blank, uploaded leaf images are safely
# stored in persistent local storage under public/uploads/scans/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Storage Option (Alternative)
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
